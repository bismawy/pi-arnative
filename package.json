{
	"name": "@bismawy/pi-arnative",
	"version": "0.16.1",
	"description": "Refined aesthetics. Cohesive tools. Built for Pi. Warm themes, rounded tool boxes, tabbed header, compact footer and a /usage dashboard.",
	"keywords": [
		"pi-package",
		"pi-theme",
		"pi-extension"
	],
	"type": "module",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bismawy/pi-arnative.git"
	},
	"homepage": "https://github.com/bismawy/pi-arnative#readme",
	"files": [
		"extensions",
		"lib",
		"themes",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"pi": {
		"image": "https://raw.githubusercontent.com/bismawy/pi-arnative/main/assets/banner.webp",
		"extensions": [
			"./extensions/index.ts"
		],
		"themes": [
			"./themes/*.json"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"scripts": {
		"dev": "pi --extension ./extensions/index.ts",
		"test": "node themes/gen-themes.mjs --check && node scripts/reporter.mjs --self-check && node --test --test-reporter=./scripts/reporter.mjs",
		"preview": "node scripts/preview.mjs",
		"overlay": "node scripts/overlay.mjs",
		"themes": "node themes/gen-themes.mjs",
		"release:check": "node scripts/release-check.mjs pre-tag",
		"prepublishOnly": "npm test && node scripts/release-check.mjs pre-publish"
	}
}
